# Copy to .env at repository root
NODE_ENV=development
PORT=3001

# Multimodal Core ($0 Free Tier -> EU Vertex AI in Production)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Speech-to-Text ($0 Free Tier: Groq Whisper-large-v3)
GROQ_API_KEY=

# Database (PocketBase self-hosted)
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Geo & Routing (Open-Source OSRM + Nominatim)
OSRM_BASE_URL=http://127.0.0.1:5000
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# Channels
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/oauth/google/callback
